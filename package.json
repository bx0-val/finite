{
  "name": "finite",
  "description": "A scroll counter for X. See how many posts you scroll past, how far, and how long.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
